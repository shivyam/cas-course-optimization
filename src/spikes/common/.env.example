# Copy this file to .env (same folder) and set the path to your local copy of the
# course outline PDFs. .env is ignored by git, so each person can use their own path.
# The folder should contain Fall_2026/ with the outline PDFs inside.
#
# Windows example (forward slashes work fine):
#   SPIKE_OUTLINES_DIR=C:/Users/harma/OneDrive/Capstone/outlines
SPIKE_OUTLINES_DIR=
