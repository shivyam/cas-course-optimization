  "learning_outcomes": [
    {
      "id": "LO1",
      "text": "Understand how are programs written in a high-level language, such as C, translated into the language of the hardware, and how does the hardware execute the resulting program.",
      "source_page": 6
    },
    {
      "id": "LO2",
      "text": "Know and understand RISC-V Instruction set architecture (ISA): functionality and use of resources (registers and memory) of a machine-level instruction",
      "source_page": 6
    },
    {
      "id": "LO3",
      "text": "The instruction classes for data movement, arithmetic/logical operations, and flow control",
      "source_page": 6
    },
    {
      "id": "LO4",
      "text": "Processor and system performance",
      "source_page": 6
    },
    {
      "id": "LO5",
      "text": "Sustainability and performance effects of power consumption",
      "source_page": 6
    },
    {
      "id": "LO6",
      "text": "Performance enhancement through instruction pipelining",
      "source_page": 6
    },
    {
      "id": "LO7",
      "text": "The memory hierarchy, composing memory and cache mapping techniques.",
      "source_page": 6
    },
    {
      "id": "LO8",
      "text": "Be able to read and write programs in RISC-V assembly language and measure the performance of components in a CPU system.",
      "source_page": 6
    }
