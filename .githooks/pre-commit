#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)

if [ -x "$repo_root/src/backend/.venv/bin/python" ]; then
  backend_python="$repo_root/src/backend/.venv/bin/python"
elif [ -x "$repo_root/src/backend/.venv/Scripts/python.exe" ]; then
  backend_python="$repo_root/src/backend/.venv/Scripts/python.exe"
else
  backend_python="${PYTHON:-python3}"
fi

printf '%s\n' 'Running backend tests...'
(cd "$repo_root/src/backend" && "$backend_python" -m pytest)

printf '%s\n' 'Running frontend tests...'
(cd "$repo_root/src/frontend" && npm test)

printf '%s\n' 'Backend and frontend tests passed.'
