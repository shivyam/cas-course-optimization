# Copy this file to .env and fill in local values.
# Never commit .env or any real secrets.

# Backend
CORS_ORIGINS=http://localhost:5173
EXTRACTED_TEXT_DIR=data/extracted_text
EXTRACTED_JSON_DIR=data/extracted_json

# Gemma extraction through the McMaster GPU SSH tunnel.
# Keep the tunnel open with: bash src/backend/scripts/gpu_ollama.sh
OLLAMA_URL=http://127.0.0.1:11435
LLM_MODEL=gemma4:e2b
LLM_NUM_CTX=16384
LLM_TIMEOUT_S=600

# Frontend
VITE_API_BASE_URL=/api
