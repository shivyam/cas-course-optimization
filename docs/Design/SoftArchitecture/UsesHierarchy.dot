// Uses hierarchy for the Module Guide (MG Section 9), matching the Uses
// section of each module in the MIS. An arrow from A to B means A uses B.
// Build: dot -Tpdf UsesHierarchy.dot -o UsesHierarchy.pdf
digraph UsesHierarchy {
  rankdir=TB; nodesep=0.25; ranksep=0.5;
  node [shape=box, style=rounded, fontname="Helvetica", fontsize=11, width=1.3];
  edge [arrowsize=0.6, color="#555555"];

  M1  [label="M1\nHardware-Hiding"];
  M2  [label="M2\nOutline Intake"];
  M3  [label="M3\nExtraction"];
  M4  [label="M4\nExtraction Review"];
  M5  [label="M5\nAssessment Schedule"];
  M6  [label="M6\nWorkload Analysis"];
  M7  [label="M7\nPolicy Compliance"];
  M8  [label="M8\nGrad. Attribute Check"];
  M9  [label="M9\nFindings and Override"];
  M10 [label="M10\nDashboard"];
  M11 [label="M11\nDate Suggestion"];
  M12 [label="M12\nExport"];
  M13 [label="M13\nAccess Control"];
  M14 [label="M14\nWeb UI"];
  M15 [label="M15\nRequest Controller"];
  M16 [label="M16\nCohort"];
  M17 [label="M17\nAcademic Calendar"];
  M18 [label="M18\nDocument Reader"];
  M19 [label="M19\nLLM Client"];
  M20 [label="M20\nData Store"];

  M14 -> M15;
  M15 -> {M2 M3 M4 M5 M6 M7 M8 M9 M10 M11 M12 M13};
  M2  -> {M3 M18 M20};
  M3  -> {M18 M19 M20};
  M4  -> M20;
  M5  -> {M4 M6 M7 M20};
  M6  -> {M4 M20 M16 M17};
  M7  -> {M4 M9 M20 M17};
  M8  -> {M4 M9 M20};
  M9  -> M20;
  M10 -> {M4 M5 M9 M20};
  M11 -> {M6 M20 M17};
  M12 -> M20;
  M13 -> M20;
  M18 -> M1; M19 -> M1; M20 -> M1;
}
